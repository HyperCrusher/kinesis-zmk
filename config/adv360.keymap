#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Workman {
            display-name = "Base";
            bindings = <
&kp EQUAL       &kp N1     &kp N2    &kp N3     &kp N4  &kp N5  &none                                                  &none      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp ESC         &kp Q      &kp D     &kp R      &kp W   &kp B   &none                                                  &none      &kp J   &kp F   &kp U      &kp P     &kp SEMI  &kp BSLH
&kp TAB         &kp A      &kp S     &kp H      &kp T   &kp G   &none    &none     &kp LALT      &none      &none      &none      &kp Y   &kp N   &kp E      &kp O     &kp I     &kp SQT
&mt LSHFT CAPS  &kp Z      &kp X     &kp M      &kp C   &kp V                      &none         &none                            &kp K   &kp L   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&none           &kp GRAVE  &kp DOWN  &kp RIGHT  &tog 1          &kp DEL  &kp BSPC  &kp LGUI      &kp LCTRL  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 0
            >;
        };

        Workman-keypad {
            display-name = "kp";
            bindings = <
&kp EQUAL       &kp N1     &kp N2    &kp N3     &kp N4  &kp N5  &none                                                  &none   &kp N6  &kp FSLH  &kp STAR  &kp MINUS  &kp N0    &kp MINUS
&kp ESC         &kp Q      &kp D     &kp R      &kp W   &kp B   &none                                                  &none   &kp J   &kp N7    &kp N8    &kp N9     &kp SEMI  &kp BSLH
&kp TAB         &kp A      &kp S     &kp H      &kp T   &kp G   &none    &none     &kp LALT      &none      &none      &none   &kp Y   &kp N4    &kp N5    &kp N6     &kp PLUS  &kp SQT
&mt LSHFT CAPS  &kp Z      &kp X     &kp M      &kp C   &kp V                      &none         &none                         &kp K   &kp N1    &kp N2    &kp N3     &kp FSLH  &kp RSHFT
&none           &kp GRAVE  &kp DOWN  &kp RIGHT  &tog 1          &kp DEL  &kp BSPC  &kp LGUI      &kp LCTRL  &kp ENTER  &kp N0          &kp UP    &kp DOWN  &kp DOT    &kp RBKT  &mo 0
            >;
        };
    };
};
