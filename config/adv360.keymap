#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hmr: homerow_mods_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_R";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <300>;
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <68 53 37 38 69 70 35 52 66 67 36 65 0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 46 47 48 49 50 51 60 61 62 63 64>;
        };

        hml: homerow_mods_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_L";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <300>;
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 37 38 39 40 41 42 43 44 45 53 54 55 56 57 58 59 68 69 70 71 72 73 74 75 35 36 52 65 66 67>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Qwerty {
            display-name = "Base";
            bindings = <
&kp EQUAL       &kp N1  &kp N2  &kp N3    &kp N4     &kp N5  &none                                                                  &none      &kp N6  &kp N7  &kp N8     &kp N9            &kp N0             &kp MINUS
&kp ESC         &kp Q   &kp W   &kp E     &kp R      &kp T   &kp PRINTSCREEN                                                        &none      &kp Y   &kp U   &kp I      &kp O             &kp P              &kp BSLH
&kp TAB         &kp A   &kp S   &kp D     &kp F      &kp G   &none            &none     &kp LEFT_ALT      &kp RIGHT_ALT  &none      &none      &kp H   &kp J   &kp K      &kp L             &kp SEMI           &kp SQT
&kp LEFT_SHIFT  &kp Z   &kp X   &kp C     &kp V      &kp B                              &kp LCTRL         &kp RCTRL                            &kp N   &kp M   &kp COMMA  &kp DOT           &kp FSLH           &kp RSHFT
&none           &none   &none   &kp LEFT  &kp RIGHT          &sl 1            &kp BSPC  &kp LEFT_GUI      &kp RIGHT_GUI  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none
            >;
        };

        symbol {
            display-name = "Base";
            bindings = <
&kp EQUAL   &kp N1    &kp N2            &kp N3          &kp N4                &kp N5     &studio_unlock                                                    &studio_unlock  &kp N6     &kp N7    &kp N8           &kp N9             &kp N0             &kp MINUS
&kp ESC     &kp Q     &kp W             &kp PLUS        &kp P                 &kp B      &kp DELETE                                                        &none           &kp J      &kp L     &kp KP_EQUAL     &kp Y              &kp SEMI           &kp BSLH
&kp TAB     &kp HASH  &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp TILDE  &bootloader     &none     &none             &none      &none      &bootloader     &kp GRAVE  &kp RPAR  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp UNDER          &kp SQT
&caps_word  &kp Z     &kp X             &kp KP_MINUS    &kp D                 &kp V                                &kp LCTRL         &kp RCTRL                             &kp K      &kp H     &kp UNDER        &kp DOT            &kp FSLH           &caps_word
&none       &none     &none             &kp LEFT        &kp RIGHT                        &none           &kp BSPC  &kp LEFT_GUI      &kp RGUI   &kp ENTER  &kp SPACE                  &kp UP    &kp DOWN         &kp LEFT_BRACKET   &kp RIGHT_BRACKET  &none
            >;
        };
    };
};
