#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Colmak {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1  &kp N2  &kp N3    &kp N4     &kp N5  &none                                           &none      &kp N6  &kp N7  &kp N8     &kp N9            &kp N0             &kp MINUS
&kp ESC    &kp Q   &kp W   &kp F     &kp P      &kp B   &none                                           &none      &kp J   &kp L   &kp U      &kp Y             &kp SEMI           &kp BSLH
&kp TAB    &kp A   &kp R   &kp S     &kp T      &kp G   &none    &none     &none      &none  &none      &none      &kp M   &kp N   &kp E      &kp I             &kp O              &kp SQT
&none      &kp Z   &kp X   &kp C     &kp D      &kp V                      &none      &none                        &kp K   &kp H   &kp COMMA  &kp DOT           &kp FSLH           &none
&none      &none   &none   &kp LEFT  &kp RIGHT          &kp DEL  &kp BSPC  &none      &none  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none
            >;
        };
    };
};
